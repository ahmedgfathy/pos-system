{
  "expo": {
    "name": "Sell-It",
    "slug": "sell-it",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#133593"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sellit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan product barcodes and QR codes"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#133593"
      },
      "package": "com.sellit.app",
      "versionCode": 2,
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sell-It to access your camera to scan barcodes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
